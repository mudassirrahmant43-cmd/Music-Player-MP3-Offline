<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer Luminous Sound Wave Ring -->
    <path
        android:pathData="M 54,20 A 34,34 0 1,0 88,54"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="20"
                android:startY="20"
                android:endX="88"
                android:endY="88"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF00E5FF" />
                <item android:offset="1.0" android:color="#FF8B5CF6" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Equalizer Frequency Bars -->
    <path
        android:pathData="M 32,54 L 32,46 M 38,54 L 38,40 M 44,54 L 44,34 M 50,54 L 50,44 M 56,54 L 56,38 M 62,54 L 62,48 M 68,54 L 68,42"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="32"
                android:startY="34"
                android:endX="68"
                android:endY="54"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF00E5FF" />
                <item android:offset="1.0" android:color="#FFA855F7" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Play Symbol Core -->
    <path
        android:pathData="M 46,62 L 64,72 L 46,82 Z"
        android:fillColor="#FF00E5FF" />

    <!-- Music Note Beam Accent -->
    <path
        android:pathData="M 72,30 A 6,6 0 1,1 66,24 L 80,20 L 80,36 A 5,5 0 1,1 75,31 Z"
        android:fillColor="#FF8B5CF6" />
</vector>
